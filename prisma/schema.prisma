generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  fullName   String
  email      String   @unique
  password   String
  role       Role     @default(CUSTOMER)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  carts      Cart[]
  order      Order[]

}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  productId String
  image     String
  color     String
  size      Size
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String   @default("")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, color, size])
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

model Product {
  id             String         @id @default(cuid())
  name           String
  description    String
  price          Int
  compareAtPrice Int?
  category       String
  gender         Gender
  isFeatured     Boolean        @default(false)
  inStock        Boolean        @default(true)
  rating         Float          @default(0.0)
  reviewCount    Int            @default(0)

  carts          Cart[]
  orderItem      OrderItem[]
  images         ProductImage[]
  colors         VariantColor[]
  sizes          VariantSize[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VariantColor {
  id        String  @id @default(cuid())
  name      String
  hex       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VariantSize {
  id        String  @id @default(cuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAID
}

enum DeliveryOption {
  delivery
  pickup
}

model Order {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  phone           String
  address         String
  additionalNotes String?
  deliveryOption  DeliveryOption
  
  subtotal        Int            
  deliveryFee     Int
  tax             Int
  total           Int
  
  status          OrderStatus    @default(PENDING)
  items           OrderItem[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  price     Int
  image     String?
  color     String?
  size      String?
  quantity  Int
  
  createdAt DateTime @default(now())
}